{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ama-metrics reusable cluster scenario matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios", "coverageGaps"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "scenarios": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cluster", "clusterFeatures", "settingsVariants", "platforms", "ginkgoLabels", "tier"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "cluster": {"type": "string", "pattern": "^clusters/[a-z0-9-]+\\.bicepparam$"},
          "clusterFeatures": {"$ref": "#/$defs/names"},
          "settingsVariants": {"$ref": "#/$defs/names"},
          "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["linux", "windows"]}},
          "ginkgoLabels": {"$ref": "#/$defs/names"},
          "tier": {"enum": ["pr", "nightly", "weekly"]},
          "blockedReason": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverageGaps": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
